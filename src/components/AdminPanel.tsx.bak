function useAdmin() {
  const locale = useLocale();
  const t = translations[locale] || translations.ar;

  return {locale, t};
}

function LanguageSwitcher({page}: {page: string}) {
  const {locale} = useAdmin();

  const langs = [
    ['ar', 'SA'],
    ['fr', 'FR'],
    ['en', 'EN'],
    ['ru', 'RU'],
    ['ur', 'PK'],
    ['id', 'ID']
  ];

  return (
    <div className="adm-languages">
      {langs.map(([code, flag]) => (
        <Link
          key={code}
          href={`/${code}/admin/${page}`}
          className={locale === code ? 'selected' : ''}
        >
          {flag}
        </Link>
      ))}
    </div>
  );
}

// ==========================================
// LOGIN
// ==========================================

export function AdminLogin() {
  const {locale, t} = useAdmin();

  const [showPassword, setShowPassword] = useState(false);
  const [message, setMessage] = useState(false);

  return (
    <main className="adm-login">

      <section className="adm-login-brand">
        <Image
          src="/brand-gold.png"
          alt="Durrat Al Hijrah"
          width={210}
          height={210}
          priority
        />

        <h1>DURRAT AL HIJRAH</h1>
        <p>REAL ESTATE MANAGEMENT</p>
      </section>

      <section className="adm-login-content">

        <div className="adm-login-top">
          <Link href={`/${locale}`}>
            <ArrowRight size={18}/>
            {t.back}
          </Link>

          <LanguageSwitcher page="login"/>
        </div>

        <div className="adm-login-card">

          <div className="adm-login-icon">
            <Lock size={28}/>
          </div>

          <span className="adm-eyebrow">
            ADMINISTRATOR ACCESS
          </span>

          <h2>{t.login}</h2>

          <p className="adm-muted">
            DURRAT AL HIJRAH
          </p>

          <form
            onSubmit={(e) => {
              e.preventDefault();
              setMessage(true);
            }}
          >

            <label>
              {t.email}
              <input
                type="email"
                placeholder="admin@example.com"
                autoComplete="username"
                required
              />
            </label>

            <label>
              {t.password}

              <div className="adm-password">
                <input
                  type={showPassword ? 'text' : 'password'}
                  placeholder="••••••••"
                  autoComplete="current-password"
                  required
                />

                <button
                  type="button"
                  onClick={() => setShowPassword(!showPassword)}
                  aria-label="Afficher le mot de passe"
                >
                  {showPassword
                    ? <EyeOff size={18}/>
                    : <Eye size={18}/>
                  }
                </button>
              </div>
            </label>

            <button type="submit" className="adm-primary">
              {t.signin}
              <ArrowRight size={18}/>
            </button>

          </form>

          {message && (
            <p className="adm-warning" role="status">
              Connexion non activée : authentification à configurer.
            </p>
          )}

          <div className="adm-separator">
            <span>DEMO</span>
          </div>

          <Link
            href={`/${locale}/admin/dashboard`}
            className="adm-secondary"
          >
            {t.demo}
          </Link>

          <p className="adm-warning">
            <ShieldAlert size={17}/>
            {t.notice}
          </p>

        </div>
      </section>
    </main>
  );
}

// ==========================================
// DONNEES TEMPORAIRES
// ==========================================

type Property = {
  id: number;
  title: string;
  district: string;
  price: number;
  area: number;
  published: boolean;
};

const initialProperties: Property[] = [
  {
    id: 1001,
    title: 'Apartment Al Aridh',
    district: 'Al Aridh',
    price: 42000,
    area: 165,
    published: true
  },
  {
    id: 1002,
    title: 'Villa Al Awali',
    district: 'Al Awali',
    price: 1850000,
    area: 420,
    published: true
  },
  {
    id: 1003,
    title: 'Apartment Qurban',
    district: 'Qurban',
    price: 56000,
    area: 210,
    published: false
  }
];

type Tab = 'dashboard' | 'properties' | 'leads' | 'telegram';

// ==========================================
// DASHBOARD
// ==========================================

export function AdminDashboard() {
  const {locale, t} = useAdmin();

  const [tab, setTab] = useState<Tab>('dashboard');
  const [properties, setProperties] = useState(initialProperties);
  const [search, setSearch] = useState('');
  const [showForm, setShowForm] = useState(false);

  const filtered = useMemo(() => {
    return properties.filter((property) =>
      `${property.title} ${property.district}`
        .toLowerCase()
        .includes(search.toLowerCase())
    );
  }, [properties, search]);

  const published = properties.filter(p => p.published).length;
  const drafts = properties.length - published;

  function addProperty(e: FormEvent<HTMLFormElement>) {
    e.preventDefault();

    const data = new FormData(e.currentTarget);

    const title = String(data.get('title') || '').trim();
    const district = String(data.get('district') || '').trim();
    const price = Number(data.get('price'));
    const area = Number(data.get('area'));

    if (
      !title ||
      !district ||
      !Number.isFinite(price) ||
      !Number.isFinite(area) ||
      price <= 0 ||
      area <= 0
    ) {
      return;
    }

    setProperties(previous => [
      {
        id: Date.now(),
        title,
        district,
        price,
        area,
        published: false
      },
      ...previous
    ]);

    setShowForm(false);
    setTab('properties');
  }

  function togglePublished(id: number) {
    setProperties(previous =>
      previous.map(property =>
        property.id === id
          ? {...property, published: !property.published}
          : property
      )
    );
  }

  function deleteProperty(id: number) {
    setProperties(previous =>
      previous.filter(property => property.id !== id)
    );
  }

  const nav = [
    {id: 'dashboard', label: t.dashboard, icon: LayoutDashboard},
    {id: 'properties', label: t.properties, icon: Building2},
    {id: 'leads', label: t.leads, icon: Users},
    {id: 'telegram', label: t.telegram, icon: Send}
  ] as const;

  return (
    <main className="adm-dashboard">

      <aside className="adm-sidebar">

        <Link href={`/${locale}`} className="adm-sidebar-logo">
          <Image
            src="/brand-gold.png"
            width={54}
            height={54}
            alt=""
          />

          <div>
            <strong>DURRAT</strong>
            <span>PROPERTY MANAGEMENT</span>
          </div>
        </Link>

        <span className="adm-sidebar-label">WORKSPACE</span>

        <nav className="adm-sidebar-nav">
          {nav.map(item => {
            const Icon = item.icon;

            return (
              <button
                type="button"
                key={item.id}
                className={tab === item.id ? 'active' : ''}
                onClick={() => setTab(item.id)}
              >
                <Icon size={20}/>
                {item.label}
              </button>
            );
          })}
        </nav>

        <div className="adm-sidebar-bottom">
          <Link href={`/${locale}/admin/login`}>
            <LogOut size={17}/>
            {t.back}
          </Link>
        </div>

      </aside>

      <div className="adm-workspace">

        <header className="adm-topbar">

          <div className="adm-breadcrumb">
            DURRAT
            <span>/</span>
            {t[tab]}
          </div>

          <LanguageSwitcher page="dashboard"/>

        </header>

        <div className="adm-main">

          <div className="adm-page-heading">

            <div>
              <span className="adm-eyebrow">
                DURRAT AL HIJRAH / ADMIN
              </span>

              <h1>
                {tab === 'dashboard' ? t.welcome : t[tab]}
              </h1>

              <p>{t.notice}</p>
            </div>

            <button
              type="button"
              className="adm-primary"
              onClick={() => setShowForm(true)}
            >
              <Plus size={19}/>
              {t.add}
            </button>

          </div>

          {tab === 'dashboard' && (
            <div className="adm-stats">

              <div className="adm-stat">
                <span>{t.total}</span>
                <strong>{properties.length}</strong>
                <Building2 size={24}/>
              </div>

              <div className="adm-stat">
                <span>{t.published}</span>
                <strong>{published}</strong>
                <CheckCircle2 size={24}/>
              </div>

              <div className="adm-stat">
                <span>{t.draft}</span>
                <strong>{drafts}</strong>
                <Clock3 size={24}/>
              </div>

              <div className="adm-stat">
                <span>{t.leads}</span>
                <strong>0</strong>
                <Users size={24}/>
              </div>

            </div>
          )}

          {(tab === 'dashboard' || tab === 'properties') && (
            <section className="adm-panel">

              <div className="adm-panel-header">

                <h2>
                  {tab === 'dashboard'
                    ? t.recent
                    : t.properties}
                </h2>

                <div className="adm-search">
                  <Search size={18}/>

                  <input
                    value={search}
                    onChange={e => setSearch(e.target.value)}
                    placeholder={t.search}
                  />
                </div>

              </div>

              <div className="adm-table-scroll">
                <table className="adm-table">

                  <thead>
                    <tr>
                      <th>{t.title}</th>
                      <th>{t.district}</th>
                      <th>{t.price}</th>
                      <th>Status</th>
                      <th>Actions</th>
                    </tr>
                  </thead>

                  <tbody>
                    {filtered.map(property => (
                      <tr key={property.id}>

                        <td>
                          <div className="adm-property-cell">
                            <div className="adm-property-icon">
                              <Building2 size={19}/>
                            </div>

                            <div>
                              <strong>{property.title}</strong>
                              <small>#{property.id}</small>
                            </div>
                          </div>
                        </td>

                        <td>
                          <MapPin size={14}/>
                          {property.district}
                        </td>

                        <td>
                          {property.price.toLocaleString()} SAR
                        </td>

                        <td>
                          <span className={
                            property.published
                              ? 'adm-status published'
                              : 'adm-status'
                          }>
                            {property.published
                              ? t.published
                              : t.draft}
                          </span>
                        </td>

                        <td>
                          <div className="adm-table-actions">

                            <button
                              type="button"
                              onClick={() =>
                                togglePublished(property.id)
                              }
                              aria-label="Toggle publication"
                            >
                              {property.published
                                ? <EyeOff size={18}/>
                                : <Eye size={18}/>}
                            </button>

                            <button
                              type="button"
                              onClick={() =>
                                deleteProperty(property.id)
                              }
                              aria-label="Delete property"
                            >
                              <Trash2 size={18}/>
                            </button>

                          </div>
                        </td>

                      </tr>
                    ))}
                  </tbody>

                </table>

                {filtered.length === 0 && (
                  <p className="adm-empty">No properties found</p>
                )}
              </div>

            </section>
          )}

          {tab === 'leads' && (
            <section className="adm-placeholder">
              <Users size={42}/>
              <h2>{t.leads}</h2>
              <p>{t.connection}</p>
            </section>
          )}

          {tab === 'telegram' && (
            <section className="adm-placeholder">
              <Send size={42}/>
              <h2>Telegram Bot</h2>
              <p>{t.connection}</p>
            </section>
          )}

        </div>
      </div>

      {showForm && (
        <div className="adm-modal-overlay">

          <section
            className="adm-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="adm-modal-title"
          >

            <div className="adm-modal-header">
              <h2 id="adm-modal-title">{t.add}</h2>

              <button
                type="button"
                onClick={() => setShowForm(false)}
                aria-label="Close"
              >
                <X size={22}/>
              </button>
            </div>

            <form onSubmit={addProperty}>

              <label>
                {t.title}
                <input
                  name="title"
                  required
                  maxLength={120}
                  placeholder="Apartment..."
                />
              </label>

              <label>
                {t.district}
                <input
                  name="district"
                  required
                  maxLength={80}
                  placeholder="Al Aridh"
                />
              </label>

              <div className="adm-form-grid">

                <label>
                  {t.price} (SAR)
                  <input
                    name="price"
                    type="number"
                    min="1"
                    required
                  />
                </label>

                <label>
                  {t.area} (m²)
                  <input
                    name="area"
                    type="number"
                    min="1"
                    required
                  />
                </label>

              </div>

              <div className="adm-modal-actions">

                <button
                  type="button"
                  className="adm-secondary"
                  onClick={() => setShowForm(false)}
                >
                  {t.cancel}
                </button>

                <button type="submit" className="adm-primary">
                  <Plus size={17}/>
                  {t.save}
                </button>

              </div>

            </form>

          </section>
        </div>
      )}

    </main>
  );
}