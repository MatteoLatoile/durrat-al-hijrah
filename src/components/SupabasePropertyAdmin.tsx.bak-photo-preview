export function SupabasePropertyEditor({
  propertyId
}: {
  propertyId?: string;
}) {
  const supabase = useMemo(() => createClient(), []);
  const router = useRouter();

  const [districts, setDistricts] = useState<District[]>([]);
  const [form, setForm] = useState<FormState>({...empty});
  const [photos, setPhotos] = useState<Photo[]>([]);
  const [files, setFiles] = useState<File[]>([]);

  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState('');
  const [photoBusy, setPhotoBusy] = useState(false);

  const [savedId, setSavedId] = useState(propertyId || '');

  const editing = Boolean(propertyId);

  const loadPhotos = useCallback(async (id: string) => {
    const {data, error} = await supabase
      .from('property_images')
      .select('id,storage_path,is_cover,sort_order')
      .eq('property_id', id)
      .order('sort_order');

    if (error) throw error;

    setPhotos((data || []) as Photo[]);
  }, [supabase]);

  useEffect(() => {
    let active = true;

    async function load() {
      try {
        const {data: districtData, error: districtError} =
          await supabase
            .from('districts')
            .select('id,names,latitude,longitude,is_active')
            .order('created_at', {ascending: false});

        if (districtError) throw districtError;

        if (active) {
          setDistricts(
            (districtData || []) as unknown as District[]
          );
        }

        if (propertyId) {
          const {data, error: propertyError} = await supabase
            .from('properties')
            .select('*')
            .eq('id', propertyId)
            .single();

          if (propertyError) throw propertyError;

          if (active) {
            const property = data as Property;

            setForm({
              title: asTranslations(property.title),
              description: asTranslations(property.description),
              district_id: property.district_id || '',
              property_type: property.property_type,
              transaction_type: property.transaction_type,
              status: property.status,
              price: String(property.price),
              area_m2: String(property.area_m2 ?? ''),
              land_area_m2: String(property.land_area_m2 ?? ''),
              bedrooms: String(property.bedrooms ?? ''),
              bathrooms: String(property.bathrooms ?? ''),
              living_rooms: String(property.living_rooms ?? ''),
              floor_number: String(property.floor_number ?? ''),
              total_floors: String(property.total_floors ?? ''),
              parking_spaces: String(property.parking_spaces ?? ''),
              property_age_years: String(property.property_age_years ?? ''),
              rent_period: property.rent_period || '',
              furnished: property.furnished || 'unfurnished',
              is_featured: property.is_featured
            });

            await loadPhotos(propertyId);
          }
        }
      } catch (cause) {
        if (active) {
          setError(
            cause instanceof Error
              ? cause.message
              : 'تعذر تحميل البيانات'
          );
        }
      } finally {
        if (active) setLoading(false);
      }
    }

    void load();

    return () => {
      active = false;
    };
  }, [propertyId, supabase, loadPhotos]);

  function update<K extends keyof FormState>(
    key: K,
    value: FormState[K]
  ) {
    setForm(previous => ({...previous, [key]: value}));
  }

  function translateField(
    field: 'title' | 'description',
    lang: string,
    value: string
  ) {
    setForm(previous => ({
      ...previous,
      [field]: {
        ...previous[field],
        [lang]: value
      }
    }));
  }

  async function removePhoto(photo: Photo) {
    if (!savedId || photoBusy) return;

    if (!confirm('هل تريد حذف الصورة؟')) return;

    setPhotoBusy(true);
    setError('');

    try {
      const {error: dbError} = await supabase
        .from('property_images')
        .delete()
        .eq('id', photo.id);

      if (dbError) throw dbError;

      const {error: storageError} = await supabase.storage
        .from('property-images')
        .remove([photo.storage_path]);

      if (storageError) {
        throw new Error(
          'تم حذف الصورة من العقار، ولكن تعذر حذف الملف من التخزين.'
        );
      }

      await loadPhotos(savedId);
    } catch (cause) {
      setError(cause instanceof Error ? cause.message : 'خطأ');
    } finally {
      setPhotoBusy(false);
    }
  }

  async function save(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    if (saving) return;

    setError('');

    if (!form.title.ar?.trim()) {
      setError('اسم العقار بالعربية مطلوب.');
      return;
    }

    if (!Number.isFinite(Number(form.price)) ||
        Number(form.price) <= 0) {
      setError('يرجى إدخال سعر صحيح.');
      return;
    }

    if (form.status === 'published') {
      const selected = districts.find(
        district => district.id === form.district_id
      );

      if (
        !selected ||
        !selected.is_active ||
        selected.latitude === null ||
        selected.longitude === null ||
        !Number.isFinite(selected.latitude) ||
        !Number.isFinite(selected.longitude)
      ) {
        setError(
          'للنشر، اختر حياً نشطاً له إحداثيات GPS صحيحة.'
        );
        return;
      }
    }

    const allowedTypes = [
      'image/jpeg',
      'image/png',
      'image/webp',
      'image/avif'
    ];

    for (const file of files) {
      if (
        !allowedTypes.includes(file.type) ||
        file.size > 10 * 1024 * 1024
      ) {
        setError(
          'الصور يجب أن تكون JPEG أو PNG أو WEBP أو AVIF وأقل من 10MB.'
        );
        return;
      }
    }

    setSaving(true);

    try {
      const payload = {
        title: form.title,
        description: form.description,
        district_id: form.district_id || null,
        property_type: form.property_type,
        transaction_type: form.transaction_type,
        price: Number(form.price),
        area_m2: numberOrNull(form.area_m2),
        land_area_m2: numberOrNull(form.land_area_m2),
        bedrooms: numberOrNull(form.bedrooms),
        bathrooms: numberOrNull(form.bathrooms),
        living_rooms: numberOrNull(form.living_rooms),
        floor_number: numberOrNull(form.floor_number),
        total_floors: numberOrNull(form.total_floors),
        parking_spaces: numberOrNull(form.parking_spaces),
        property_age_years: numberOrNull(form.property_age_years),
        rent_period: form.transaction_type === 'rent'
          ? form.rent_period || null
          : null,
        furnished: form.furnished,
        is_featured: form.is_featured
      };

      let id = savedId;

      if (id) {
        const {error: updateError} = await supabase
          .from('properties')
          .update({
            ...payload,
            status: form.status
          })
          .eq('id', id);

        if (updateError) throw updateError;

      } else {
        // Creation en brouillon avant l'envoi des images.
        const {data, error: createError} = await supabase
          .from('properties')
          .insert({
            ...payload,
            status: 'draft'
          })
          .select('id')
          .single();

        if (createError) throw createError;

        id = data.id;
        setSavedId(id);
      }

      const existingCount = photos.length;

      const extensions: Record<string, string> = {
        'image/jpeg': 'jpg',
        'image/png': 'png',
        'image/webp': 'webp',
        'image/avif': 'avif'
      };

      for (let i = 0; i < files.length; i++) {
        const file = await processWatermarkedPhoto(files[i], existingCount + i);

        const extension = extensions[file.type];
        const storagePath =
          `${id}/${crypto.randomUUID()}.${extension}`;

        const {error: uploadError} = await supabase.storage
          .from('property-images')
          .upload(storagePath, file, {
            contentType: file.type,
            upsert: false
          });

        if (uploadError) throw uploadError;

        const {error: imageError} = await supabase
          .from('property_images')
          .insert({
            property_id: id,
            storage_path: storagePath,
            sort_order: existingCount + i,
            is_cover: existingCount === 0 && i === 0
          });

        if (imageError) {
          await supabase.storage
            .from('property-images')
            .remove([storagePath]);

          throw imageError;
        }
      }

      if (!propertyId && form.status !== 'draft') {
        const {error: publishError} = await supabase
          .from('properties')
          .update({status: form.status})
          .eq('id', id);

        if (publishError) throw publishError;
      }

      router.replace(`/ar/admin/properties/${id}/edit`);
      router.refresh();

    } catch (cause) {
      setError(
        (cause instanceof Error ? cause.message : 'خطأ') +
        ' — قد يكون العقار قد حُفظ جزئياً. تحقق من قائمة العقارات.'
      );
    } finally {
      setSaving(false);
    }
  }

  if (loading) {
    return (
      <main className="dh-pa" dir="rtl">
        <div className="dh-pa-empty">جارٍ تحميل النموذج...</div>
      </main>
    );
  }

  return (
    <main className="dh-pa" dir="rtl">
      <div className="dh-pa-container">

        <div className="dh-pa-heading">
          <div>
            <Link href="/ar/admin/properties" className="dh-pa-back">
              <ArrowRight size={15}/> جميع العقارات
            </Link>

            <h1>
              {editing ? 'تعديل العقار' : 'إضافة عقار جديد'}
            </h1>

            <p>يتم حفظ المعلومات في Supabase</p>
          </div>
        </div>

        {error && (
          <div className="dh-pa-error" role="alert">{error}</div>
        )}

        <form onSubmit={save} className="dh-pa-form">

          <section className="dh-pa-panel">
            <h2>المعلومات الأساسية</h2>

            <div className="dh-pa-fields">

              <label>
                <span>الحي</span>
                <select
                  value={form.district_id}
                  onChange={e => update('district_id', e.target.value)}
                >
                  <option value="">اختر الحي</option>

                  {districts.map(district => (
                    <option key={district.id} value={district.id}>
                      {district.names?.ar || district.id}
                      {!district.is_active ? ' (غير نشط)' : ''}
                    </option>
                  ))}
                </select>
              </label>

              <label>
                <span>نوع العقار</span>
                <select
                  value={form.property_type}
                  onChange={e => update('property_type', e.target.value)}
                >
                  {types.map(([value, label]) => (
                    <option key={value} value={value}>
                      {label}
                    </option>
                  ))}
                </select>
              </label>

              <label>
                <span>نوع العملية</span>
                <select
                  value={form.transaction_type}
                  onChange={e => update('transaction_type', e.target.value)}
                >
                  <option value="sale">بيع</option>
                  <option value="rent">إيجار</option>
                </select>
              </label>

              <label>
                <span>السعر بالريال السعودي ⃁</span>
                <input
                  type="number"
                  min="1"
                  step="any"
                  value={form.price}
                  onChange={e => update('price', e.target.value)}
                  required
                  dir="ltr"
                />
              </label>

              {form.transaction_type === 'rent' && (
                <label>
                  <span>مدة الإيجار</span>
                  <select
                    value={form.rent_period}
                    onChange={e => update('rent_period', e.target.value)}
                  >
                    <option value="">غير محدد</option>
                    <option value="daily">يومي</option>
                    <option value="monthly">شهري</option>
                    <option value="yearly">سنوي</option>
                  </select>
                </label>
              )}

              <label>
                <span>الحالة</span>
                <select
                  value={form.status}
                  onChange={e => update('status', e.target.value as Status)}
                >
                  {statuses.map(([value, label]) => (
                    <option key={value} value={value}>
                      {label}
                    </option>
                  ))}
                </select>
              </label>

              <label>
                <span>التأثيث</span>
                <select
                  value={form.furnished}
                  onChange={e => update('furnished', e.target.value)}
                >
                  <option value="unfurnished">غير مفروش</option>
                  <option value="furnished">مفروش</option>
                  <option value="partially_furnished">مفروش جزئياً</option>
                </select>
              </label>

            </div>

            <label className="dh-pa-checkbox">
              <input
                type="checkbox"
                checked={form.is_featured}
                onChange={e => update('is_featured', e.target.checked)}
              />
              عقار مميز
            </label>

          </section>

          <section className="dh-pa-panel">
            <h2>مواصفات العقار</h2>

            <div className="dh-pa-fields">
              {([
                ['area_m2', 'المساحة م²'],
                ['land_area_m2', 'مساحة الأرض م²'],
                ['bedrooms', 'غرف النوم'],
                ['bathrooms', 'دورات المياه'],
                ['living_rooms', 'غرف المعيشة'],
                ['floor_number', 'رقم الطابق'],
                ['total_floors', 'عدد الطوابق'],
                ['parking_spaces', 'مواقف السيارات'],
                ['property_age_years', 'عمر العقار بالسنوات']
              ] as const).map(([key, label]) => (
                <label key={key}>
                  <span>{label}</span>

                  <input
                    type="number"
                    min={key === 'floor_number' ? undefined : 0}
                    step="any"
                    dir="ltr"
                    value={form[key]}
                    onChange={e => update(key, e.target.value)}
                  />
                </label>
              ))}
            </div>
          </section>

          <section className="dh-pa-panel">
            <h2>الترجمات — 6 لغات</h2>

            <div className="dh-pa-translations">
              {languages.map(([lang, label]) => (
                <div className="dh-pa-language" key={lang}>
                  <h3>{label}</h3>

                  <label>
                    <span>عنوان العقار {lang === 'ar' ? '*' : ''}</span>

                    <input
                      value={form.title[lang] || ''}
                      onChange={e =>
                        translateField('title', lang, e.target.value)
                      }
                      dir={lang === 'ar' || lang === 'ur' ? 'rtl' : 'ltr'}
                      required={lang === 'ar'}
                    />
                  </label>

                  <label>
                    <span>وصف العقار</span>

                    <textarea
                      rows={4}
                      value={form.description[lang] || ''}
                      onChange={e =>
                        translateField('description', lang, e.target.value)
                      }
                      dir={lang === 'ar' || lang === 'ur' ? 'rtl' : 'ltr'}
                    />
                  </label>
                </div>
              ))}
            </div>
          </section>

          <section className="dh-pa-panel">
            <h2>صور العقار</h2>

            <p className="dh-pa-muted">
              JPEG, PNG, WEBP ou AVIF — maximum 10 Mo par photo.
            </p>

            <label className="dh-pa-upload">
              <ImagePlus size={28}/>
              <span>اختيار الصور</span>

              <input
                type="file"
                multiple
                accept="image/jpeg,image/png,image/webp,image/avif"
                onChange={e => {
                  const selected = Array.from(e.currentTarget.files || []);

                  setFiles(previous => {
                    const combined = [...previous, ...selected];

                    return combined.filter((file, index) =>
                      combined.findIndex(other =>
                        other.name === file.name &&
                        other.size === file.size &&
                        other.lastModified === file.lastModified
                      ) === index
                    );
                  });

                  e.currentTarget.value = '';
                }}
              />
            </label>

            {files.length > 0 && (
              <p className="dh-pa-muted">
                {files.length} صور جاهزة للرفع عند الحفظ
              </p>
            )}

            {photos.length > 0 && (
              <div className="dh-pa-photos">
                {photos.map(photo => (
                  <div key={photo.id} className="dh-pa-photo">
                    <img
                      src={storageUrl(photo.storage_path)}
                      alt=""
                    />

                    {photo.is_cover && (
                      <span className="dh-pa-cover">الرئيسية</span>
                    )}

                    <button
                      type="button"
                      disabled={photoBusy}
                      onClick={() => void removePhoto(photo)}
                      aria-label="حذف الصورة"
                    >
                      <Trash2 size={15}/>
                    </button>
                  </div>
                ))}
              </div>
            )}
          </section>

          <div className="dh-pa-savebar">
            <button
              type="submit"
              className="dh-pa-primary"
              disabled={saving}
            >
              <Save size={18}/>
              {saving ? 'جارٍ الحفظ...' : 'حفظ العقار'}
            </button>

            <Link href="/ar/admin/properties">
              إلغاء
            </Link>
          </div>

        </form>
      </div>
    </main>
  );
}