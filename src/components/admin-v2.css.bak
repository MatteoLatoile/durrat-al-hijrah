.av-shell{--av-dark:#182621;--av-gold:#c6a36b;--av-border:#e5e8e1;background:#f7f8f4;color:#27352d;min-height:100vh;display:grid;grid-template-columns:250px minmax(0,1fr);font-family:inherit}
.av-sidebar{background:var(--av-dark);color:#e2e8dc;padding:26px 16px;display:flex;flex-direction:column;gap:16px}
.av-brand{display:flex;align-items:center;gap:10px;color:#d7ba86;font-size:17px;font-weight:800}
.av-brand img{width:49px;height:49px;object-fit:contain}
.av-brand small{display:block;font-size:11px;color:#9aa99c;font-weight:400;margin-top:5px}
.av-side-label{border-top:1px solid #ffffff20;margin-top:19px;padding-top:24px;color:#9da9a0;font-size:11px}
.av-nav{display:flex;flex-direction:column;gap:5px}
.av-nav button,.av-nav a{display:flex;align-items:center;gap:12px;text-align:right;padding:13px;color:#c2cec3;border:0;background:transparent;border-radius:7px;width:100%;font-size:13px;cursor:pointer}
.av-nav .selected,.av-nav button:hover,.av-nav a:hover{background:#c6a36b21;color:#d7ba86}
.av-exit{margin-top:auto;border-top:1px solid #ffffff20;padding-top:20px;font-size:12px;color:#bba782}
.av-content{min-width:0}
.av-topbar{background:white;padding:19px 4%;border-bottom:1px solid var(--av-border);display:flex;align-items:center;justify-content:space-between;gap:15px;color:#849187;font-size:12px}
.av-topbar strong{color:#7b6a51}
.av-main{padding:36px 4% 90px;max-width:1500px;margin:auto}
.av-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;margin-bottom:28px}
.av-heading h1{font-size:clamp(26px,3.5vw,37px);margin:8px 0}
.av-heading p,.av-muted{font-size:12px;color:#819085;line-height:1.9}
.av-eyebrow{font:700 10px sans-serif;color:#a98959;letter-spacing:.12em}
.av-btn{display:inline-flex;gap:8px;align-items:center;justify-content:center;padding:12px 18px;border-radius:7px;font-size:13px;font-weight:700;min-height:45px;border:1px solid transparent;cursor:pointer}
.av-btn:disabled{opacity:.5;cursor:wait}
.av-primary{background:var(--av-gold);color:#17241d}
.av-outline{background:white;border-color:#dce1d7;color:#526054}
.av-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px;margin-bottom:23px}
.av-stats>div{background:white;border:1px solid var(--av-border);border-radius:9px;padding:21px;min-height:125px;display:flex;flex-direction:column;justify-content:space-between}
.av-stats span{font-size:12px;color:#829085}
.av-stats strong{font-size:34px;color:#26362c}
.av-panel{background:white;border:1px solid var(--av-border);border-radius:10px;overflow:hidden}
.av-padding{padding:25px}
.av-padding h2{font-size:20px;margin:0 0 24px}
.av-panel-head{display:flex;align-items:center;justify-content:space-between;padding:20px 25px;gap:20px;flex-wrap:wrap}
.av-panel-head h2{font-size:19px}
.av-search{display:flex;gap:8px;align-items:center;padding:0 12px;border:1px solid var(--av-border);border-radius:7px;background:#fafbf9}
.av-search input{border:0;background:transparent;outline:0;padding:12px;min-width:0;font-size:13px}
.av-table-scroll{overflow-x:auto}
.av-table{width:100%;border-collapse:collapse;text-align:right;font-size:12px}
.av-table th,.av-table td{padding:16px 18px;border-bottom:1px solid #eef0eb;white-space:nowrap;text-align:right}
.av-table th{color:#758376;background:#f7f8f4;font-weight:700}
.av-property{display:flex;align-items:center;gap:11px}
.av-property strong{font-size:13px}
.av-property small{display:block;color:#889a8b;margin-top:4px}
.av-cover{width:45px;height:45px;border-radius:6px;background:#eee8df;display:grid;place-items:center;color:#c4a677;overflow:hidden}
.av-cover img{width:100%;height:100%;object-fit:cover}
.av-tag{display:inline-block;background:#efece5;color:#8f764f;border-radius:15px;padding:5px 11px}
.av-tag.on{background:#e9f4eb;color:#408454}
.av-actions{display:flex;align-items:center;gap:7px}
.av-actions a,.av-actions button{display:grid;place-items:center;width:37px;height:37px;border:1px solid #e2e6dc;border-radius:6px;background:white;color:#a18453;cursor:pointer}
.av-actions :is(a,button):hover{background:#f4f1e8}
.av-empty{padding:35px;text-align:center;color:#88968c}
.av-placeholder{min-height:260px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:15px;padding:30px;text-align:center}
.av-placeholder svg{color:#bfa173}
.av-placeholder h2{font-size:20px}
.av-placeholder p{font-size:13px;color:#819085}
.av-columns{display:grid;grid-template-columns:1.25fr .75fr;gap:20px;align-items:start}
.av-form,.av-edit{display:flex;flex-direction:column;gap:22px}
.av-translations{border:0;padding:0;margin:0;min-width:0}
.av-translations legend{font-size:19px;font-weight:750;padding:0 0 20px}
.av-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:17px}
.av-fields label{display:flex;flex-direction:column;gap:8px;font-size:12px;font-weight:650;color:#536358;min-width:0}
.av-fields input,.av-fields select,.av-fields textarea{display:block;width:100%;min-width:0;background:#fafbf9;color:#223429;border:1px solid #dfe4da;border-radius:7px;font-size:14px;padding:12px;outline:0}
.av-fields input,.av-fields select{min-height:46px}
.av-fields textarea{resize:vertical}
.av-fields :is(input,select,textarea):focus{border-color:#b99962;outline:2px solid #c6a36b22}
.av-controls{display:flex;gap:10px;flex-wrap:wrap}
.av-notice{background:#f8efe2;padding:13px 16px;border-radius:6px;color:#92692e;font-size:13px}
.av-district-list{display:flex;flex-direction:column;gap:10px}
.av-district{display:flex;align-items:center;justify-content:space-between;gap:13px;padding:12px;border:1px solid var(--av-border);border-radius:6px}
.av-district>span{display:flex;align-items:center;gap:8px;font-size:13px}
.av-edit{max-width:1050px}
.av-upload{position:relative;min-height:155px;border:2px dashed #cbb89b;background:#fbfaf6;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:7px;color:#92774e;cursor:pointer}
.av-upload strong{font-size:15px}
.av-upload span{font-size:11px}
.av-upload input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%}
.av-photo-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:18px}
.av-photo{position:relative;aspect-ratio:4/3;background:#eff0e9;border-radius:6px;overflow:hidden}
.av-photo img{width:100%;height:100%;object-fit:cover}
.av-photo button{position:absolute;top:7px;left:7px;background:#fff;border:0;border-radius:5px;padding:7px;cursor:pointer;color:#b04b3c}
.av-photo small{position:absolute;bottom:0;right:0;left:0;background:#182621cc;color:white;text-align:center;font-size:10px;padding:6px}
.av-check{display:flex;gap:12px;align-items:center;font-size:14px;font-weight:650}
.av-check input{accent-color:#b99b67;width:20px;height:20px}
@media(max-width:980px){
.av-shell{grid-template-columns:200px minmax(0,1fr)}
.av-columns{grid-template-columns:1fr}
.av-stats{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:700px){
.av-shell{display:block}
.av-sidebar{padding:12px}
.av-brand,.av-side-label,.av-exit{display:none}
.av-nav{flex-direction:row;overflow-x:auto}
.av-nav button,.av-nav a{white-space:nowrap;width:auto;min-width:max-content}
.av-topbar{padding:14px 5%}
.av-main{padding:25px 5% 70px}
.av-fields{grid-template-columns:1fr}
.av-photo-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}